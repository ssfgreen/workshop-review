# Team access code people type to sign in
ACCESS_CODE=change-me
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# libSQL database: a local file in development, a Turso URL in production
DATABASE_URL=file:local.db
# Only for Turso
DATABASE_AUTH_TOKEN=
